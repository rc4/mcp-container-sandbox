{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.typedarrays"],
    "module": "es2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["test"],
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
